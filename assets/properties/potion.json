{
  "schema_version": 3,
  "id": "potions",
  "title": "Зелья",
  "rules": {
    "default_applies_to": "new_items_only",
    "preserve_unrecognized_properties": true,
    "do_not_overwrite_missing_fields": true,
    "editable_combobox": false,
    "values_are_daedalus_expressions": true,
    "instance_is_not_c_item_property": true,
    "unique_instance_case_insensitive": true
  },
  "instance": {
    "prefix": "ItPo_",
    "suffix_default_pattern": "Potion{n}",
    "numbering_start": 1,
    "unique_case_insensitive": true
  },
  "generated_defaults": {
    "mainflag": "ITEM_KAT_POTIONS",
    "visual": "\"ItPo_Perm_Health.3ds\"",
    "material": "MAT_GLAS",
    "scemeName": "\"POTIONFAST\"",
    "text[5]": "NAME_Value",
    "count[5]": "value"
  },
  "option_lists": {
    "itemFlagsList": [
      {
        "name": "Без дополнительных флагов",
        "value": "0"
      },
      {
        "name": "Складываемое",
        "value": "ITEM_MULTI"
      },
      {
        "name": "Квестовый предмет",
        "value": "ITEM_MISSION"
      },
      {
        "name": "Складываемый квестовый предмет",
        "value": "ITEM_MULTI | ITEM_MISSION"
      },
      {
        "name": "Не разделять стопку",
        "value": "ITEM_NSPLIT"
      }
    ],
    "visualEffects": [
      {
        "name": "Нет",
        "value": "\"\""
      }
    ],
    "itemSchemes": [
      {
        "name": "Быстро выпить (POTIONFAST)",
        "value": "\"POTIONFAST\""
      },
      {
        "name": "Выпить (POTION)",
        "value": "\"POTION\""
      }
    ]
  },
  "sections": [
    {
      "id": "general",
      "title": "Основное",
      "fields": [
        {
          "key": "instance",
          "label": "ID",
          "type": "identifier",
          "widget": "input",
          "source": "instance_id",
          "required": true,
          "default": "Potion{n}",
          "prefix": "ItPo_",
          "placeholder": "Potion1"
        },
        {
          "key": "name",
          "label": "Название (при подборе)",
          "type": "string",
          "widget": "input",
          "source": "property",
          "required": true,
          "default": "\"Новое зелье\"",
          "placeholder": "Новое зелье"
        },
        {
          "key": "description",
          "label": "Название (в инвентаре)",
          "type": "string",
          "widget": "input",
          "source": "property",
          "tooltip": "Если не указано, то\nвозьмет значение названия при подборе",
          "default": "name",
          "placeholder": "Новое зелье"
        }
      ]
    },
    {
      "id": "parameters",
      "title": "Параметры",
      "fields": [
        {
          "key": "flags",
          "label": "Флаги",
          "type": "flags",
          "widget": "combobox",
          "source": "property",
          "default": "ITEM_MULTI",
          "options_ref": "itemFlagsList"
        },
        {
          "key": "value",
          "label": "Стоимость (монет)",
          "type": "expression",
          "widget": "input",
          "source": "property",
          "default": "100",
          "placeholder": "100"
        }
      ]
    },
    {
      "id": "appearance",
      "title": "Внешний вид",
      "fields": [
        {
          "key": "effect",
          "label": "Визуальный эффект",
          "type": "enum",
          "widget": "combobox",
          "options_ref": "visualEffects",
          "options_source": "visual_effects"
        }
      ]
    },
    {
      "id": "actions",
      "title": "Действия",
      "fields": [
        {
          "key": "scemeName",
          "label": "Анимация использования",
          "type": "enum",
          "widget": "combobox",
          "default": "\"POTIONFAST\"",
          "options_ref": "itemSchemes",
          "options_source": "item_schemes"
        }
      ]
    },
    {
      "id": "inventory",
      "title": "Инвентарь",
      "fields": [
        {
          "key": "inventory_rows",
          "label": "Строки инвентаря",
          "type": "key_value_list",
          "max_rows": 6,
          "start_index": 0,
          "columns": [
            {
              "variable": "text",
              "label": "Текст",
              "type": "string"
            },
            {
              "variable": "count",
              "label": "Значение",
              "type": "expression"
            }
          ],
          "reserved": {
            "text": "NAME_Value"
          }
        }
      ]
    }
  ],
  "unknown_properties": {
    "preserve": true,
    "show_in_section": null
  },
  "missing_properties": {
    "show_empty": true,
    "write_only_if_modified": true
  }
}
