    {
      "id": "advanced",
      "title": "Дополнительно",
      "fields": [
        {
          "key": "description_raw",
          "label": "Дополнительный комментарий редактора",
          "type": "string",
          "widget": "input",
          "placeholder": "",
          "description": "Метаданные редактора, не экспортируются в Daedalus.",
          "source": "editor_metadata",
          "export": false
