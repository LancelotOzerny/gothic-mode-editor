{
  "id": "potions",
  "title": "Зелья",
  "rules": {
    "default_applies_to": "new_items_only",
    "preserve_unrecognized_properties": true,
    "do_not_overwrite_missing_fields": true,
    "editable_combobox": false,
    "values_are_daedalus_expressions": true,
    "instance_is_not_c_item_property": true,
    "unique_instance_case_insensitive": true
  },
  "instance": {
    "prefix": "ItPo_",
    "suffix_default_pattern": "Potion{n}",
    "numbering_start": 1,
    "unique_case_insensitive": true
  },
  "generated_defaults": {
    "mainflag": "ITEM_KAT_POTIONS",
    "visual": "\"ItPo_Perm_Health.3ds\"",
    "material": "MAT_GLAS",
    "scemeName": "\"POTIONFAST\""
  },
  "unknown_properties": {
    "preserve": true,
    "show_in_section": null
  },
  "missing_properties": {
    "show_empty": true,
    "write_only_if_modified": true
  },
  "field_overrides": {
    "instance": {
      "prefix": "ItPo_",
      "default": "Potion{n}",
      "placeholder": "Potion1"
    },
    "name": {
      "default": "\"Новое зелье\"",
      "placeholder": "Новое зелье"
    },
    "description": {
      "placeholder": "Новое зелье"
    }
  }
}
